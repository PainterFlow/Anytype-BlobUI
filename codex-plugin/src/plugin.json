{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "anyblob",
  "version": "0.2.27",
  "description": "Read and manage permitted Anytype content through BlobUI on Windows.",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Anyblob",
        "shortDescription": "Manage Anytype through BlobUI",
        "capabilities": [
          "Read",
          "Write"
        ],
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
