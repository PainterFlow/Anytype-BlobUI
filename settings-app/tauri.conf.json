{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlobUI Settings",
  "version": "2.0.0",
  "identifier": "io.blobui.settings",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BlobUI Settings",
        "width": 960,
        "height": 740,
        "minWidth": 800,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "decorations": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
